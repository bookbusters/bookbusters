<!DOCTYPE html>
<html>
<head>
  <title>BookBusters Picks</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#0b0f19] text-white p-6">

  <h1 class="text-3xl font-bold mb-6">All Picks</h1>

  <div id="picks" class="grid md:grid-cols-3 gap-6"></div>

  <script>
    async function loadPicks() {
      const res = await fetch('./picks.json');
      const data = await res.json();

      document.getElementById("picks").innerHTML =
        data.map(p => `
          <div class="bg-[#111827] p-6 rounded-xl">
            <h2 class="font-bold">${p.title}</h2>
            <p class="text-gray-400">${p.sport}</p>
          </div>
        `).join("");
    }

    loadPicks();
  </script>

</body>
</html>
