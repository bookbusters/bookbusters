<!DOCTYPE html>
<html>
<head>
  <title>Picks</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#0b0f19] text-white">

<nav class="flex gap-6 p-4 border-b border-gray-800">
  <a href="index.html">🏠 Dashboard</a>
  <a href="picks.html">📊 Picks</a>
  <a href="research.html">🧠 Research</a>
  <a href="vip.html">🔒 VIP</a>
</nav>

<div class="p-8">

  <h1 class="text-4xl font-bold mb-6">📊 Daily Picks</h1>

  <div id="picks" class="grid md:grid-cols-3 gap-4"></div>

</div>

<script>
async function loadPicks() {
  const res = await fetch('./picks.json');
  const data = await res.json();

  document.getElementById("picks").innerHTML = data.map(p => `
    <div class="bg-[#111827] p-5 rounded-2xl border border-gray-800 hover:scale-105 transition">

      <h2 class="text-xl font-bold">🏀 ${p.player || p.title}</h2>

      <p class="text-gray-400 mt-2">
        ${p.sport} — ${p.bet || ""}
      </p>

      <p class="mt-3 text-blue-400">
        Line: ${p.line}
      </p>

      <p class="mt-2 text-green-400">
        Confidence: ${p.confidence}%
      </p>

      <p class="mt-3 text-sm text-gray-400">
        Risk: ${p.risk}
      </p>

    </div>
  `).join("");
}

loadPicks();
</script>

</body>
</html>
